{
  "name": "escritorio-en-mano",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Controla tu PC desde el móvil con estética cristal oscuro (Tauri + Express + React).",
  "main": "server/dist/index.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:tauri": "tauri dev",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "tsc --noEmit && vite build",
    "build": "npm run build:server && npm run build:web",
    "start": "node server/dist/index.js",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icons.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "framer-motion": "^12.43.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
