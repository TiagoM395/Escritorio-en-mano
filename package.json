{
  "name": "escritorio-en-mano",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Controla tu PC desde el móvil con estética cristal oscuro (Tauri + Express + React).",
  "main": "server/dist/index.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:tauri": "tauri dev",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "tsc --noEmit && vite build",
    "build": "npm run build:server && npm run build:web",
    "start": "node server/dist/index.js",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icons.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "framer-motion": "^12.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
