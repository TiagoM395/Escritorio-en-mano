{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Escritorio en Mano",
  "version": "0.1.0",
  "identifier": "com.tiagom395.escritorioenmano",
  "build": {
    "beforeDevCommand": "npm run build:server && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Escritorio en Mano",
        "width": 1100,
        "height": 760,
        "minWidth": 380,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
